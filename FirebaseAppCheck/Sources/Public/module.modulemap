// The module map of the `FirebaseAppCheck` SwiftPM target. CocoaPods generates its own module
// map from the podspec.
module FirebaseAppCheck {
  umbrella header "FirebaseAppCheck/FirebaseAppCheck.h"
  export *

  // NOT PUBLIC API: declarations that the Swift implementation of the SDK
  // (`FirebaseAppCheckSwift`) uses internally.
  explicit module Internal {
    header "FirebaseAppCheck/FIRAppCheckInternal.h"
    export *
  }
}
