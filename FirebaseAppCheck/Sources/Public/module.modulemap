// The module map of the `FirebaseAppCheck` SwiftPM target (and translated by `zip-builder` for
// binary XCFramework distributions). CocoaPods generates its own module map from the podspec.
module FirebaseAppCheck {
  umbrella header "FirebaseAppCheck/FirebaseAppCheck.h"
  export *

  // NOT PUBLIC API: declarations that the Swift implementation of the SDK
  // (`FirebaseAppCheckSwift`) implements internally.
  explicit module Internal {
    header "../Internal/FIRAppCheckInternal.h"
    export *
  }
}
