<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  A fake configuration for the integration tests against the Storage and Auth emulators. No
  request reaches production. The bucket has the production bucket's name only because the tests
  expect that name in errors.
-->
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>fake-api-key-for-the-emulators</string>
	<key>BUNDLE_ID</key>
	<string>org.cocoapods.AppHost-FirebaseStorage-Unit-Tests</string>
	<key>GCM_SENDER_ID</key>
	<string>123456789000</string>
	<key>GOOGLE_APP_ID</key>
	<string>1:123456789000:ios:0000000000000000</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>PROJECT_ID</key>
	<string>demo-storage-tests</string>
	<key>STORAGE_BUCKET</key>
	<string>ios-opensource-samples.appspot.com</string>
</dict>
</plist>
